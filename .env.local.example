# Copier en .env.local puis adapter — instance LI-ERP-004\DEVPERSO :
# Option A — nom d'instance (SQL Browser requis : service "SQL Server Browser" démarré, UDP 1434 ouvert) :
MSSQL_CONNECTION_STRING=Server=LI-ERP-004\DEVPERSO;Database=supergestion;User Id=sa;Password=MotDePasseSa!;Encrypt=true;TrustServerCertificate=true
# Option B — port fixe TCP (port visible via netstat, SQL Browser non requis) :
# MSSQL_CONNECTION_STRING=Server=LI-ERP-004,14331;Database=supergestion;User Id=supergestion;Password=MotDePasse!;Encrypt=true;TrustServerCertificate=true
# Secret de signature des sessions (obligatoire en production) :
# SG_SECRET=chaine-aleatoire-longue
# Flag Secure du cookie (à activer UNIQUEMENT derrière HTTPS) :
# SG_COOKIE_SECURE=true
